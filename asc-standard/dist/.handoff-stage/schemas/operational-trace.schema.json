{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asc-standard.dev/schemas/operational-trace.schema.json",
  "title": "Operational Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "missionId",
    "profile",
    "tickCount",
    "ticks",
    "finalTipHash"
  ],
  "properties": {
    "schemaVersion": {"type": "string", "const": "0.1"},
    "missionId": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "tickCount": {"type": "integer", "minimum": 1},
    "finalTipHash": {"type": "string", "minLength": 1},
    "ticks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tick",
          "ts_ms",
          "kernel_input",
          "expected_verdict",
          "expected_reasons",
          "expected_tip_hash"
        ],
        "properties": {
          "tick": {"type": "integer", "minimum": 1},
          "ts_ms": {"type": "integer", "minimum": 0},
          "kernel_input": {"type": "object"},
          "expected_verdict": {"type": "string", "minLength": 1},
          "expected_reasons": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "expected_tip_hash": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
