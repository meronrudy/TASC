{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asc-standard.dev/schemas/replay-recipe.schema.json",
  "title": "TASC Replay Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipeVersion",
    "profile",
    "seedsDigest",
    "buildDigest",
    "configDigest",
    "environmentDigest",
    "containerDigest",
    "reproducibilityGuarantee",
    "replaySlaHours"
  ],
  "properties": {
    "recipeVersion": {"type": "string", "pattern": "^0\\.1$"},
    "profile": {"type": "string", "minLength": 1},
    "seedsDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "buildDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "configDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "environmentDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "containerDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reproducibilityGuarantee": {"type": "string", "minLength": 1},
    "replaySlaHours": {"type": "integer", "minimum": 1}
  }
}
