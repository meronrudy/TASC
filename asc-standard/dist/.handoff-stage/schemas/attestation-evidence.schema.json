{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asc-standard.dev/schemas/attestation-evidence.schema.json",
  "title": "TASC Attestation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "level",
    "deviceIdentity",
    "keyId",
    "issuer",
    "certificateProfile",
    "evidenceDigest",
    "chainDigest",
    "nonce",
    "valid",
    "keyLifecycle",
    "claims"
  ],
  "properties": {
    "attestationVersion": {"type": "string", "pattern": "^0\\.(1|2)$"},
    "level": {"type": "string", "enum": ["TA0", "TA1", "TA2"]},
    "deviceIdentity": {"type": "string", "minLength": 1},
    "keyId": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "certificateProfile": {"type": "string", "minLength": 1},
    "evidenceDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "chainDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "evidenceSignature": {"type": "string", "minLength": 8},
    "evidenceSignatureAlgorithm": {"type": "string", "enum": ["rsa-sha256"]},
    "signingTimeUtc": {"type": "string", "format": "date-time"},
    "signerCertificatePath": {"type": "string", "minLength": 1},
    "certificateChainPath": {"type": "string", "minLength": 1},
    "trustRootsDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "revocationSnapshotDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "revocationSnapshotPath": {"type": "string", "minLength": 1},
    "keySource": {"type": "string", "enum": ["FILE", "PKCS11"]},
    "nonce": {"type": "string", "minLength": 8},
    "valid": {"type": "boolean"},
    "keyLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rotationDays", "maxKeyAgeDays", "revocationEndpoint", "lastRotated"],
      "properties": {
        "rotationDays": {"type": "integer", "minimum": 1},
        "maxKeyAgeDays": {"type": "integer", "minimum": 1},
        "revocationEndpoint": {"type": "string", "minLength": 1},
        "lastRotated": {"type": "string", "format": "date"}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secureBootMeasured", "hsmBacked", "softwareStateDigest"],
      "properties": {
        "secureBootMeasured": {"type": "boolean"},
        "hsmBacked": {"type": "boolean"},
        "softwareStateDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"attestationVersion": {"const": "0.2"}}
      },
      "then": {
        "required": [
          "evidenceSignature",
          "evidenceSignatureAlgorithm",
          "signingTimeUtc",
          "signerCertificatePath",
          "certificateChainPath",
          "trustRootsDigest",
          "revocationSnapshotDigest",
          "revocationSnapshotPath",
          "keySource"
        ]
      }
    }
  ]
}
