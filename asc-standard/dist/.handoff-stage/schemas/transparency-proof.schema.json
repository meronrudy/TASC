{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asc-standard.dev/schemas/transparency-proof.schema.json",
  "title": "TASC Transparency Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proofVersion",
    "logId",
    "logUrl",
    "entryUuid",
    "logIndex",
    "treeSize",
    "rootHash",
    "leafHash",
    "checkpoint",
    "checkpointHash",
    "entryDigest",
    "inclusionPath",
    "consistencyPath",
    "inclusionProofHash",
    "consistencyProofHash",
    "signature",
    "verifiedOffline",
    "integratedTimeUtc",
    "source"
  ],
  "properties": {
    "proofVersion": {"type": "string", "pattern": "^0\\.(1|2)$"},
    "logId": {"type": "string", "enum": ["rekor", "mirror"]},
    "logUrl": {"type": "string", "minLength": 1},
    "entryUuid": {"type": "string", "minLength": 1},
    "logIndex": {"type": "integer", "minimum": 0},
    "treeSize": {"type": "integer", "minimum": 0},
    "rootHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "leafHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "checkpoint": {"type": "string", "minLength": 1},
    "checkpointHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "entryDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "inclusionPath": {
      "type": "array",
      "items": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
    },
    "consistencyPath": {
      "type": "array",
      "items": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
    },
    "inclusionProofHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "consistencyProofHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "integratedTimeUtc": {"type": "string", "format": "date-time"},
    "signature": {"type": "string", "minLength": 8},
    "verifiedOffline": {"type": "boolean"},
    "source": {"type": "string", "enum": ["live", "local"]}
  }
}
