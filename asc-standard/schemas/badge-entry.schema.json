{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asc-standard.dev/schemas/badge-entry.schema.json",
  "title": "TASC Badge Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "badgeId",
    "badgeType",
    "systemDigest",
    "specVersion",
    "conformanceReportDigest",
    "attestationDigest",
    "issuedAt",
    "expiresAt",
    "status",
    "transparencyLogIds"
  ],
  "properties": {
    "badgeId": {"type": "string", "minLength": 1},
    "badgeType": {"type": "string", "enum": ["TASC_CONFORMANT", "TASC_AUDIT_GRADE"]},
    "systemDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "specVersion": {"type": "string", "minLength": 1},
    "conformanceReportDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "attestationDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["active", "suspended", "revoked"]},
    "revocationReason": {"type": "string"},
    "transparencyLogIds": {
      "type": "array",
      "items": {"type": "string", "enum": ["rekor", "mirror"]},
      "minItems": 2,
      "uniqueItems": true
    }
  }
}
